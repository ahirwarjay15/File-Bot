# Copy to .env on the Oracle server and fill in values there.
BOT_TOKEN=
OWNER_ID=
MONGODB_URI=
MONGODB_DB_NAME=file_bot
# Optional: Telegram source channel ID, e.g. -1001234567890
SOURCE_CHANNEL_ID=
# Optional comma-separated channel IDs/usernames for force-join checks
FORCE_JOIN_CHANNELS=
LOG_LEVEL=INFO
