# Copy to .env on the server; never commit real values.
BOT_TOKEN=
OWNER_ID=
MONGODB_URI=
MONGODB_DB_NAME=file_bot
# Process role: all (legacy single-process), main (Telegram polling), or worker (queue workers only).
# Use main on the Oracle host and worker on Render only after worker lease/recovery is hardened.
APP_ROLE=all
# Private source channel ID (bot must be an administrator)
SOURCE_CHANNEL_ID=
# Comma-separated required channels, e.g. @channel_one,@channel_two
FORCE_JOIN_CHANNELS=
LOG_LEVEL=INFO
