# Copy to .env on the server; never commit real values.
BOT_TOKEN=
OWNER_ID=
MONGODB_URI=
MONGODB_DB_NAME=file_bot
# Private source channel ID (bot must be an administrator)
SOURCE_CHANNEL_ID=
# Comma-separated required channels, e.g. @channel_one,@channel_two
FORCE_JOIN_CHANNELS=
LOG_LEVEL=INFO

# Main Bot control-plane mode (APP_ROLE=control)
APP_ROLE=control
MAIN_BOT_TOKEN=
MAIN_MONGODB_URI=
TOKEN_ENCRYPTION_KEY=
# Worker pools 1-15 map to Atlas-2 through Atlas-16; keep each pool assigned to one bot.
WORKER_MONGODB_URI_1=
WORKER_MONGODB_URI_2=
WORKER_MONGODB_URI_3=
WORKER_MONGODB_URI_4=
WORKER_MONGODB_URI_5=
WORKER_MONGODB_URI_6=
WORKER_MONGODB_URI_7=
WORKER_MONGODB_URI_8=
WORKER_MONGODB_URI_9=
WORKER_MONGODB_URI_10=
WORKER_MONGODB_URI_11=
WORKER_MONGODB_URI_12=
WORKER_MONGODB_URI_13=
WORKER_MONGODB_URI_14=
WORKER_MONGODB_URI_15=
